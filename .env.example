# ============================================================
# Sentio — FastAPI Backend (Python / gRPC)
# Copy this file to .env and fill in your values.
# All keys map directly to fields in core/config.py (pydantic-settings).
# ============================================================

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
APP_NAME=Sentio FastAPI Backend
ENV=development
# Set to "release" / "production" / "prod" to disable DEBUG mode
DEBUG=true
API_PREFIX=/api

# ----------------------------------------------------------
# Logging
# LOG_FORMAT: "json" (structured) or "console" (human-readable)
# ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=false
# LOG_FILE_PATH=./logs/sentio.log   # required when ENABLE_FILE_LOGGING=true

# ----------------------------------------------------------
# gRPC server (the Gateway connects here)
# ----------------------------------------------------------
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# ----------------------------------------------------------
# Upstream services
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
NODE_BACKEND_URL=http://localhost:5000

# ----------------------------------------------------------
# CORS — allowed origins for the HTTP FastAPI server
# Value must be a JSON array string.
# ----------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4000"]

# ----------------------------------------------------------
# Gemini API
# Get your key at https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# Optional: separate key for distress scoring (falls back to GEMINI_API_KEY)
# DISTRESS_API_KEY=your-distress-gemini-api-key

# ----------------------------------------------------------
# Gemini model selection
# GEMINI_MODEL overrides all model fields when set (optional).
# ----------------------------------------------------------
# GEMINI_MODEL=                          # leave blank to use per-task models below
GEMINI_API_VERSION=v1beta
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_TEXT_MODEL=gemini-3.8-live
GEMINI_AUDIO_MODEL=gemini-3.8-live
GEMINI_DISTRESS_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash

# ----------------------------------------------------------
# Gemini Live voice & system prompt
# GEMINI_VOICE_NAME options: Puck, Charon, Kore, Fenrir, Aoede
# ----------------------------------------------------------
GEMINI_VOICE_NAME=Puck
DEFAULT_SYSTEM_INSTRUCTION=You are a Therapist
